# ============================================================
# R26-SE-017 — Environment template (safe to commit to GitHub)
# Copy this file to .env and fill in the real values.
# ============================================================

# ─── Shared Neon Postgres ───────────────────────────────────
NEON_DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require&channel_binding=require
CONNECTION_STRING=postgresql://USER:PASS@HOST/DB?sslmode=require&channel_binding=require

# ─── Local Artifact Storage ─────────────────────────────────
ARTIFACT_ROOT=D:/AgentOutputs
STORAGE_BACKEND=local          # local | r2 | cloudinary

# ─── Cloudflare R2 (leave blank in dev) ────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sdlc-artifacts
R2_PUBLIC_URL=

# ─── LLM API keys ───────────────────────────────────────────
GROQ_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=your_openrouter_api_key_here
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# ─── Agent 1 — LiveKit & Auth ───────────────────────────────
LIVEKIT_URL=wss://your-livekit-domain.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
JWT_SECRET=your_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ─── Agent 2 — HLD ─────────────────────────────────────────
HLD_CAS_THRESHOLD=0.60
HLD_LLM_BACKEND=openrouter

# ─── Agent 3 — LLD Multi-Model Candidates & Expert Reviewer ─
GENERATION_MODEL_1=qwen/qwen-2.5-coder-32b-instruct
GENERATION_MODEL_2=meta-llama/llama-3.3-70b-instruct
GENERATION_MODEL_3=qwen/qwen-2.5-72b-instruct
EXPERT_REVIEW_MODEL=deepseek/deepseek-r1

# ─── Agent 4 — UI Screen Planning & Generation ─────────────
UI_PLANNER_MODEL=qwen/qwen3-coder
UI_GENERATOR_MODEL=qwen/qwen3-coder

# ─── Cloudinary Storage (UML Diagrams & UI Prototypes) ──────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=LLD

# ─── Service Ports & URLs ───────────────────────────────────
PORT_ORCHESTRATOR=8000
PORT_AGENT1=8001
PORT_AGENT2=8002
PORT_AGENT3=8003
PORT_AGENT4=8004
PORT_SRS=8005

AGENT1_URL=http://127.0.0.1:8001
AGENT2_URL=http://127.0.0.1:8002
AGENT3_URL=http://127.0.0.1:8003
AGENT4_URL=http://127.0.0.1:8004
SRS_URL=http://127.0.0.1:8005
ORCHESTRATOR_URL=http://127.0.0.1:8000

# ─── Frontend ───────────────────────────────────────────────
VITE_ORCHESTRATOR_URL=http://127.0.0.1:8000
VITE_AGENT1_URL=http://127.0.0.1:8001

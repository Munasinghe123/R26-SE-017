# ============================================================
# R26-SE-017  —  Unified Production Environment Configuration (Example)
# Copy this file to .env and populate with your own credentials.
# ============================================================

# ── General & Deployment Settings ──
WEB_PORT=80
DOCKER_USER=subharath
STORAGE_BACKEND=local
ARTIFACT_ROOT=/app/outputs

# ── Shared Neon Postgres Database (All Agents) ──
NEON_DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require&channel_binding=require
CONNECTION_STRING=postgresql://USER:PASS@HOST/DB?sslmode=require&channel_binding=require

# ── Ports ──
PORT_ORCHESTRATOR=8000
PORT_AGENT1=8001
PORT_AGENT2=8002
PORT_AGENT3=8003
PORT_AGENT4=8004
PORT_SRS=8005

# ── Internal Service URLs (Docker Network) ──
AGENT1_URL=http://agent1-requirements:8001
AGENT2_URL=http://agent2-hld:8002
AGENT3_URL=http://agent3-lld:8003
AGENT4_URL=http://agent4-ui:8004
SRS_URL=http://srs-assembler:8005
ORCHESTRATOR_URL=http://orchestrator:8000
REDIS_URL=redis://redis:6379/0

# ── Frontend API Base URLs (relative path uses Nginx reverse proxy) ──
VITE_ORCHESTRATOR_URL=
VITE_AGENT1_URL=
VITE_AGENT4_URL=

# ── LLM Providers & API Keys ──
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_API_KEY=
GROQ_API_KEY=

# ── Agent 1: LiveKit (Real-Time Audio / Meetings) ──
LIVEKIT_URL=wss://your-livekit-domain.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ── Agent 1: JWT Authentication ──
JWT_SECRET=your_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── Agent 2: High-Level Design (HLD) Engine ──
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1
HLD_CAS_THRESHOLD=0.60
HLD_LLM_BACKEND=openrouter
OPENROUTER_MODEL_1=openai/gpt-4o-mini
OPENROUTER_MODEL_2=qwen/qwen-2.5-coder-32b-instruct
OPENROUTER_MODEL_3=deepseek/deepseek-chat-v3-0324
OPENROUTER_TIMEOUT=75
GENERATION_TEMPERATURE=0.1
GENERATION_MAX_TOKENS=3000
GENERATION_TOP_P=0.2
GENERATION_SEEDS=42,137,256
MAX_CANDIDATES_PER_MODEL=1
DIAGRAM_TEMPERATURE=0.1
DIAGRAM_MAX_TOKENS=2500
DIAGRAM_TOP_P=0.2
DIAGRAM_SEED=42
DIAGRAM_MAX_ITERATIONS=2
TEMPERATURE_SWEEP_VALUES=0.0,0.1,0.3,0.5,0.7,1.0
RTS_THRESHOLD=0.55
QAC_THRESHOLD=0.50

# ── Agent 3: Low-Level Design (LLD) Engine ──
GENERATION_MODEL_1=qwen/qwen-2.5-coder-32b-instruct
GENERATION_MODEL_2=meta-llama/llama-3.3-70b-instruct
GENERATION_MODEL_3=qwen/qwen-2.5-72b-instruct
EXPERT_REVIEW_MODEL=deepseek/deepseek-r1

# ── Agent 4: UI Wireframing, Usability & Code Generator ──
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AGENT4_LLM_MODEL=qwen/qwen3-coder
AGENT4_LLM_TEMPERATURE=0.2
AGENT4_PLANNER_MAX_TOKENS=1800
AGENT4_GENERATOR_MAX_TOKENS=4096
AGENT4_SCORE_THRESHOLD=85
AGENT4_MAX_ITERATIONS=5
AGENT4_WEAK_SUBMETRIC_THRESHOLD=2
AGENT4_WCAG_REFINE_TRIGGER=70
AGENT4_WEIGHT_ISO=0.30
AGENT4_WEIGHT_NIELSEN=0.30
AGENT4_WEIGHT_WCAG=0.40
NODE_BIN=node
AGENT4_AXE_TIMEOUT=45
CORS_ORIGINS=*

# ── Cloudinary Image & Diagram Hosting (Agent 3 & Agent 4) ──
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=LLD

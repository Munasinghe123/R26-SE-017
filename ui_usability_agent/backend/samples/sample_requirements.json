{
  "project_name": "StayEasy Hotel Booking Platform",
  "description": "A comprehensive hotel booking system that allows guests to search for rooms, make reservations, and manage their bookings. Hotel staff can manage room inventory, view bookings, and check in guests. System administrators can oversee hotel settings and user accounts.",
  "fr": [
    {
      "id": "FR01",
      "title": "User Account Registration",
      "description": "Guests can create a new account using their email, password, and personal details."
    },
    {
      "id": "FR02",
      "title": "User Login/Logout",
      "description": "Registered users (Guests, Staff, Admin) can log in with their credentials and log out."
    },
    {
      "id": "FR03",
      "title": "Room Search and Filter",
      "description": "Guests can search for available rooms based on dates, room type, and number of guests. They can filter results by price and amenities."
    },
    {
      "id": "FR04",
      "title": "View Room Details",
      "description": "Guests can view detailed information about a specific room, including photos, description, price, and available amenities."
    },
    {
      "id": "FR05",
      "title": "Create Booking",
      "description": "Logged-in guests can select a room and dates to create a reservation, providing payment information."
    },
    {
      "id": "FR06",
      "title": "View Personal Bookings",
      "description": "Guests can view a list of their upcoming and past bookings."
    },
    {
      "id": "FR07",
      "title": "Cancel Booking",
      "description": "Guests can cancel an upcoming booking, subject to the cancellation policy."
    },
    {
      "id": "FR08",
      "title": "Staff Dashboard",
      "description": "Hotel staff can view a dashboard summarizing current occupancy, upcoming check-ins, and recent bookings."
    },
    {
      "id": "FR09",
      "title": "Staff - Manage Bookings",
      "description": "Hotel staff can view all bookings, search for a specific booking, and update its status (e.g., check-in, check-out)."
    },
    {
      "id": "FR10",
      "title": "Staff - Manage Room Inventory",
      "description": "Hotel staff can update room availability, pricing, and details for each room type."
    },
    {
      "id": "FR11",
      "title": "Admin - User Management",
      "description": "Administrators can view, create, edit, and deactivate user accounts (including staff accounts)."
    }
  ],
  "nfr": [
    {
      "id": "NFR01",
      "type": "Responsiveness",
      "description": "The user interface must be fully responsive and usable on devices from 320px (mobile) to 1920px (desktop)."
    },
    {
      "id": "NFR02",
      "type": "Accessibility",
      "description": "The application must comply with WCAG 2.1 Level AA standards to be accessible to users with disabilities."
    },
    {
      "id": "NFR03",
      "type": "Security",
      "description": "All sensitive data, including passwords and payment information, must be encrypted."
    }
  ],
  "use_cases": [
    {
      "id": "UC01",
      "actor": "Guest",
      "title": "Book a Room",
      "flow": "Search for rooms -> View details -> Select room -> Provide payment -> Confirm booking."
    },
    {
      "id": "UC02",
      "actor": "Hotel Staff",
      "title": "Check-in a Guest",
      "flow": "Search for booking by name or confirmation number -> Verify details -> Mark guest as checked-in."
    }
  ],
  "design_artifacts": {
    "class_diagram": {
      "classes": [
        {
          "name": "Guest",
          "attributes": [
            "guestId",
            "fullName",
            "email",
            "phone",
            "passwordHash"
          ],
          "methods": [
            "register()",
            "login()",
            "cancelBooking(bookingId)"
          ]
        },
        {
          "name": "Room",
          "attributes": [
            "roomId",
            "roomType",
            "pricePerNight",
            "capacity",
            "availability",
            "amenities"
          ],
          "methods": [
            "updateAvailability(status)",
            "updatePricing(price)"
          ]
        },
        {
          "name": "Booking",
          "attributes": [
            "bookingId",
            "guestId",
            "roomId",
            "checkInDate",
            "checkOutDate",
            "totalPrice",
            "status"
          ],
          "methods": [
            "calculateTotalPrice()",
            "updateStatus(newStatus)"
          ]
        },
        {
          "name": "StaffMember",
          "attributes": [
            "staffId",
            "fullName",
            "email",
            "role"
          ],
          "methods": [
            "viewDashboard()",
            "manageBooking(bookingId)",
            "manageRoomInventory(roomId)"
          ]
        }
      ],
      "relationships": [
        {
          "source": "Guest",
          "target": "Booking",
          "type": "association",
          "cardinality": "1..*"
        },
        {
          "source": "Room",
          "target": "Booking",
          "type": "association",
          "cardinality": "1..*"
        },
        {
          "source": "StaffMember",
          "target": "Booking",
          "type": "dependency",
          "cardinality": ""
        }
      ]
    },
    "er_diagram": {
      "entities": [
        {
          "name": "Guest",
          "attributes": [
            {
              "name": "guest_id",
              "type": "UUID",
              "key": "PK"
            },
            {
              "name": "full_name",
              "type": "VARCHAR"
            },
            {
              "name": "email",
              "type": "VARCHAR",
              "key": "UNIQUE"
            },
            {
              "name": "phone",
              "type": "VARCHAR"
            },
            {
              "name": "password_hash",
              "type": "VARCHAR"
            }
          ]
        },
        {
          "name": "Room",
          "attributes": [
            {
              "name": "room_id",
              "type": "UUID",
              "key": "PK"
            },
            {
              "name": "room_type",
              "type": "VARCHAR"
            },
            {
              "name": "price_per_night",
              "type": "DECIMAL"
            },
            {
              "name": "capacity",
              "type": "INT"
            },
            {
              "name": "availability",
              "type": "BOOLEAN"
            }
          ]
        },
        {
          "name": "Booking",
          "attributes": [
            {
              "name": "booking_id",
              "type": "UUID",
              "key": "PK"
            },
            {
              "name": "guest_id",
              "type": "UUID",
              "key": "FK -> Guest.guest_id"
            },
            {
              "name": "room_id",
              "type": "UUID",
              "key": "FK -> Room.room_id"
            },
            {
              "name": "check_in_date",
              "type": "DATE"
            },
            {
              "name": "check_out_date",
              "type": "DATE"
            },
            {
              "name": "total_price",
              "type": "DECIMAL"
            },
            {
              "name": "status",
              "type": "VARCHAR"
            }
          ]
        }
      ],
      "relationships": [
        {
          "from": "Guest",
          "to": "Booking",
          "cardinality": "1:N"
        },
        {
          "from": "Room",
          "to": "Booking",
          "cardinality": "1:N"
        }
      ]
    },
    "sequence_diagram": {
      "scenario": "Create Booking",
      "actors": [
        "Guest",
        "FrontendUI",
        "OrderController",
        "Booking",
        "PaymentGateway",
        "DatabaseRepository"
      ],
      "messages": [
        {
          "from": "Guest",
          "to": "FrontendUI",
          "action": "selectRoomAndDates()"
        },
        {
          "from": "FrontendUI",
          "to": "OrderController",
          "action": "submitCheckout(guestId, roomId, dates)"
        },
        {
          "from": "OrderController",
          "to": "Booking",
          "action": "calculateTotalPrice()"
        },
        {
          "from": "OrderController",
          "to": "PaymentGateway",
          "action": "chargePayment(amount)"
        },
        {
          "from": "PaymentGateway",
          "to": "OrderController",
          "action": "paymentConfirmed()"
        },
        {
          "from": "OrderController",
          "to": "DatabaseRepository",
          "action": "saveBooking(booking)"
        },
        {
          "from": "DatabaseRepository",
          "to": "FrontendUI",
          "action": "bookingConfirmation()"
        }
      ]
    }
  }
}